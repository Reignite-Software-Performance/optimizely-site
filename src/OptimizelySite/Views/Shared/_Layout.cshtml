@{
    var pageTitle = ViewData["Title"] as string;
    var fullTitle = string.IsNullOrWhiteSpace(pageTitle)
        ? "Reignite × Optimizely — performance engineering"
        : $"{pageTitle} · Reignite × Optimizely";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet">
    <title>@fullTitle</title>
    <meta name="description" content="Reignite performance engineering for Optimizely CMS and Commerce — traces, dumps, a diagnostics control plane, and a Teams diagnostics bot.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/site.css">
</head>
<body>
    <header class="site-header">
        <div class="container site-header__inner">
            <a class="brand" href="/" aria-label="Reignite and Optimizely">
                <span class="brand-chip"><img src="/images/reignite-logo.webp" alt="Reignite"></span>
                <span class="brand-x">×</span>
                <span class="brand-opt"><span class="dot"></span>Optimizely</span>
            </a>
            <nav class="site-nav" aria-label="Primary">
                <a href="/">Home</a>
                <a href="/about">About</a>
                <a href="/contact">Contact</a>
                <a href="/diagnostics-lab">Diagnostics Lab</a>
                <a class="nav-cta" href="/contact">Talk to us</a>
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <a class="brand" href="/">
                        <span class="brand-chip"><img src="/images/reignite-logo.webp" alt="Reignite"></span>
                        <span class="brand-x">×</span>
                        <span class="brand-opt"><span class="dot"></span>Optimizely</span>
                    </a>
                    <p>Performance engineering for Optimizely delivery. We find the milliseconds, prove the fix, and keep production under observation.</p>
                </div>
                <div class="footer-col">
                    <h4>Platform</h4>
                    <a href="/about">Profiler</a>
                    <a href="/about">Diagnostics control plane</a>
                    <a href="/about">Teams diagnostics bot</a>
                    <a href="/diagnostics-lab">Diagnostics Lab</a>
                </div>
                <div class="footer-col">
                    <h4>Company</h4>
                    <a href="/about">About</a>
                    <a href="/contact">Contact</a>
                    <a href="/about">Partners</a>
                    <a href="/contact">Careers</a>
                </div>
                <div class="footer-col">
                    <h4>Legal</h4>
                    <a href="/about">Privacy</a>
                    <a href="/about">Terms</a>
                    <a href="/about">Security</a>
                    <a href="/about">Status</a>
                </div>
            </div>
            <div class="footer-bottom">
                <span>© 2026 Reignite Software Performance, LLC · Charleston, South Carolina</span>
                <span class="legal"><span>Built on Optimizely CMS 13</span><span>·</span><span>Powered by Reignite</span></span>
            </div>
        </div>
    </footer>
</body>
</html>
