@model OptimizelySite.Models.Pages.StartPage
@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Model.Heading · Optimizely</title>
    <style>
        body { font: 16px/1.6 system-ui, sans-serif; margin: 0; color: #111827; background: #f8fafc; }
        header { background: #0f172a; color: #e5e7eb; padding: 1rem 2rem; }
        nav a { color: #e5e7eb; margin-right: 1.25rem; text-decoration: none; font-weight: 600; }
        nav a:hover { text-decoration: underline; }
        main { max-width: 52rem; margin: 3rem auto; padding: 0 1.5rem; }
        h1 { font-size: 2.25rem; line-height: 1.15; }
        a { color: #1d4ed8; }
    </style>
</head>
<body>
    <header>
        <nav>
            <a href="/">Home</a>
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
            <a href="/diagnostics-lab">Diagnostics Lab</a>
        </nav>
    </header>
    <main>
        <h1>@Model.Heading</h1>
        @Html.Raw(Model.MainBody?.ToHtmlString() ?? string.Empty)
    </main>
</body>
</html>
