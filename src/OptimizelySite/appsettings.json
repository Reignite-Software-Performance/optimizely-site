{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "EPiServer": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "urls": "http://*:8000/;https://*:8001/;",
  "AllowedHosts": "*",
  "Lab": {
    "Enabled": false,
    "MaxMemoryMb": 512,
    "MaxCpuSeconds": 30,
    "MaxHoldSeconds": 60,
    "MaxSqlDelayMs": 30000,
    "MaxThreads": 64
  },
  "Performance": {
    "Profiler": {
      "ProfilerID": "ce94c788-f15a-49e0-8de9-604152873b16",
      "Environment": "Production",
      "KeyID": "5CA3AF61-A914-F011-AAA5-0022484AEB86",
      "Secret": "",
      "Disabled": false,
      "StartDelaySecs": 5
    },
    "Client": {
      "Environment": "Production",
      "EnvironmentUrls": {
        "Development": "https://localhost:44332/api/v1/",
        "Integration": "https://apiintegrationapp.azurewebsites.net/api/v1/",
        "Preproduction": "https://prep.api.reigniteperformance.com/api/v1/",
        "Production": "https://api.reigniteperformance.com/api/v1/"
      }
    },
    "CommonTraceProviders": {
      "Providers": [
        "System.Runtime:0:1:EventCounterIntervalSec=1",
        "Microsoft.AspNetCore.Hosting:0:1:EventCounterIntervalSec=1",
        "Microsoft.AspNetCore.Http.Connections:0:1:EventCounterIntervalSec=1",
        "Microsoft-AspNetCore-Server-Kestrel:0:1:EventCounterIntervalSec=1",
        "System.Net.Http:0:1:EventCounterIntervalSec=1",
        "Microsoft.Data.SqlClient.EventSource:0:1:EventCounterIntervalSec=1",
        "Reignite.Profiler:0:1:EventCounterIntervalSec=1"
      ]
    },
    "EventSourceActions": [
      {
        "EventSource": "System.Runtime",
        "DisplayName": "cpu-usage",
        "Operator": ">",
        "Threshold": 80,
        "Trace": true,
        "TraceProfile": "cpu-sampling",
        "TraceTriggerType": "CPU",
        "Dump": true
      },
      {
        "EventSource": "System.Runtime",
        "DisplayName": "monitor-lock-contention-count",
        "Operator": ">",
        "Threshold": 20,
        "Trace": true,
        "TraceProfile": "cpu-sampling",
        "TraceTriggerType": "Locks",
        "Dump": true
      },
      {
        "EventSource": "System.Runtime",
        "DisplayName": "time-in-jit",
        "Operator": ">",
        "Threshold": 1000,
        "Trace": true,
        "TraceProfile": "cpu-sampling",
        "TraceTriggerType": "Jit",
        "TraceProviders": [
          "Microsoft-Windows-DotNETRuntime:0x6000080018:5",
          "Microsoft.Data.SqlClient.EventSource:0:1:EventCounterIntervalSec=1"
        ],
        "ClrEvents": [
          "Fusion",
          "Loader",
          "JIT",
          "NGEN",
          "JITTracing"
        ],
        "Dump": false
      },
      {
        "EventSource": "System.Runtime",
        "DisplayName": "gen-0-gc-count",
        "Operator": ">",
        "Threshold": 10,
        "Trace": true,
        "TraceProfile": "gc-verbose",
        "TraceTriggerType": "Gen0Gcs",
        "Dump": false
      },
      {
        "EventSource": "System.Runtime",
        "DisplayName": "gen-1-gc-count",
        "Operator": ">",
        "Threshold": 5,
        "Trace": true,
        "TraceProfile": "gc-verbose",
        "TraceTriggerType": "Gen1Gcs",
        "Dump": false
      },
      {
        "EventSource": "System.Runtime",
        "DisplayName": "gen-2-gc-count",
        "Operator": ">",
        "Threshold": 2,
        "Trace": true,
        "TraceProfile": "gc-verbose",
        "TraceTriggerType": "Gen2Gcs",
        "Dump": false
      },
      {
        "EventSource": "System.Runtime",
        "DisplayName": "exception-count",
        "Operator": ">",
        "Threshold": 100,
        "Trace": true,
        "TraceProfile": "cpu-sampling",
        "TraceTriggerType": "Exceptions",
        "Dump": false
      },
      {
        "EventSource": "System.Http",
        "DisplayName": "requests-started-rate",
        "Operator": ">",
        "Threshold": 50,
        "Trace": true,
        "TraceProfile": "cpu-sampling",
        "TraceTriggerType": "Http",
        "Dump": false
      },
      {
        "EventSource": "System.Http",
        "DisplayName": "requests-failed-rate",
        "Operator": ">",
        "Threshold": 10,
        "Trace": true,
        "TraceProfile": "cpu-sampling",
        "TraceTriggerType": "Http",
        "Dump": false
      },
      {
        "EventSource": "System.Net.Sockets",
        "DisplayName": "current-outgoing-connect-attempts",
        "Operator": ">",
        "Threshold": 50,
        "Trace": true,
        "TraceProfile": "cpu-sampling",
        "TraceTriggerType": "Sockets",
        "Dump": true
      },
      {
        "EventSource": "System.Http",
        "DisplayName": "http11-requests-queue-duration",
        "Operator": ">",
        "Threshold": 50,
        "Trace": true,
        "TraceProfile": "cpu-sampling",
        "TraceTriggerType": "Http",
        "Dump": true
      },
      {
        "EventSource": "System.Http",
        "DisplayName": "http20-requests-queue-duration",
        "Operator": ">",
        "Threshold": 50,
        "Trace": true,
        "TraceProfile": "cpu-sampling",
        "TraceTriggerType": "Http",
        "Dump": true
      },
      {
        "EventSource": "System.Http",
        "DisplayName": "http30-requests-queue-duration",
        "Operator": ">",
        "Threshold": 50,
        "Trace": true,
        "TraceProfile": "cpu-sampling",
        "TraceTriggerType": "Http",
        "Dump": true
      },
      {
        "EventSource": "System.Runtime",
        "DisplayName": "thread-pool-queue-length",
        "Operator": ">",
        "Threshold": 75,
        "Trace": true,
        "TraceProfile": "cpu-sampling",
        "TraceTriggerType": "ThreadPool",
        "Dump": true
      }
    ]
  }
}